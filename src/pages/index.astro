---
/**
 * トップページ（design/TopPage v2.dc.html）。
 *
 * marketing-plan.md が未確定のため、キャッチコピー・ヒーローセクションは置かない
 * （design/ にも存在しない）。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import SEO from "../components/SEO.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SideNav from "../components/SideNav.astro";
import SelectorAvatar from "../components/SelectorAvatar.astro";
import { SITE } from "../config";
import { websiteJsonLd } from "../lib/jsonld";
import ArticleThumbnail from "../components/ArticleThumbnail.astro";
import {
  getAllInterviews,
  getSelectorGroups,
  getTopicGroups,
  formatDate,
  toArticleHref,
  toSelectorHref,
  toTopicHref,
  selectorOf,
} from "../lib/collections";

const articles = await getAllInterviews();
const selectors = await getSelectorGroups();
const topics = await getTopicGroups();

/**
 * トップに出す新着の本数。
 *
 * 以前は全記事をここに流していたが、記事が20本を超えると
 * 横スクロールの奥に何本あるか分からず、探す用途にも新着を知る用途にも
 * 中途半端になった。**探すのは /articles の役目**にして、ここは新着だけ出す。
 */
const LATEST_COUNT = 8;
const latest = articles.slice(0, LATEST_COUNT);
---

<BaseLayout headSlot>
  <SEO
    slot="head"
    title={SITE.name}
    description={SITE.description}
    noSuffix
    canonical="/"
    jsonLd={websiteJsonLd()}
  />

  <SiteHeader />

  <div class="flex items-start">
    <div
      class="sticky top-[68px] hidden max-h-[calc(100vh-68px)] w-[232px] flex-none self-start lg:block"
    >
      <SideNav />
    </div>

    <main class="min-w-0 flex-auto px-5 pt-10 pb-24 md:px-7">
      {/* design/ にヒーローセクションがないため、h1 は読み上げ専用にする。
          h1 が無いページは見出し階層として不正（requirements 非機能要件） */}
      <h1 class="sr-only">{SITE.name} — {SITE.description}</h1>

      {/* 新着 */}
      <section class="mb-16">
        <div class="mb-6 flex items-center gap-3.5">
          <span class="h-[22px] w-1 flex-none bg-brand" aria-hidden="true"></span>
          <h2 class="m-0 text-[26px] leading-[1.5] font-bold">新着の記事</h2>
          {/* 新着は8本まで。残りは記事一覧へ送る */}
          {
            articles.length > LATEST_COUNT && (
              <a
                href="/articles"
                class="ml-auto flex-none text-[13px] whitespace-nowrap no-underline"
              >
                すべての記事を見る（{articles.length}本）→
              </a>
            )
          }
        </div>

        {/* 記事0本のとき、見出しだけが残って空欄になるのを避ける。
            公開直後や、全記事を下書きに戻したときに実際に起きる状態 */}
        {
          articles.length === 0 && (
            <p class="m-0 text-[15px] leading-[1.9] text-muted">
              最初の記事を準備しています。
            </p>
          )
        }

        <div class="flex gap-6 overflow-x-auto pb-2">
          {
            latest.map((entry) => (
              <a
                href={toArticleHref(entry)}
                class="group flex w-[236px] flex-none flex-col gap-3 text-inherit no-underline hover:text-inherit"
              >
                {/* 白背景に溶けないよう罫線を入れる。
                    「テーマから探す」「選者から探す」のカードと同じ視覚言語に揃える */}
                <div
                  class="overflow-hidden border border-rule transition-colors group-hover:border-brand"
                >
                  <ArticleThumbnail
                    slug={entry.data.slug}
                    books={entry.data.books}
                  />
                </div>
                <div class="text-base leading-[1.6] font-bold text-pretty">
                  {entry.data.title}
                </div>
                <div class="flex items-center gap-2.5 text-xs text-muted">
                  <span>{selectorOf(entry).name}</span>
                  <span class="h-2.5 w-px bg-rule" aria-hidden="true" />
                  <span>{formatDate(entry.data.publishedAt)}</span>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      {/* テーマから探す */}
      {
        topics.length > 0 && (
          <section class="mb-16">
            <div class="mb-6 flex items-center gap-3.5">
              <span class="h-[22px] w-1 flex-none bg-brand" aria-hidden="true" />
              <h2 class="m-0 text-[26px] leading-[1.5] font-bold">
                テーマから探す
              </h2>
            </div>
            {/* 折り返すグリッドにする。
                以前は「新着の記事」と挙動を揃えるために横スクロールにしていたが、
                **テーマは数が限られていて全部見えることのほうが価値が高い**。
                横スクロールだと奥に何テーマあるか分からず、
                記事数の偏り（どこに厚みがあるか）も読み取れなかった。
                新着だけは「続きがある」ことを示す横スクロールのままにする */}
            <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4">
              {topics.map((t) => (
                <a
                  href={toTopicHref(t.name)}
                  class="flex h-full flex-col gap-2 border border-rule p-5 text-inherit no-underline hover:border-brand hover:text-inherit"
                >
                  <span class="text-base font-bold">{t.name}</span>
                  <span class="text-[13px] text-muted">
                    記事{t.articles.length}本
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {/* 選者から探す */}
      {
        selectors.length > 0 && (
          <section class="mb-16">
            <div class="mb-6 flex items-center gap-3.5">
              <span class="h-[22px] w-1 flex-none bg-brand" aria-hidden="true" />
              <h2 class="m-0 text-[26px] leading-[1.5] font-bold">
                選者から探す
              </h2>
            </div>
            <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4">
              {selectors.map((s) => (
                <a
                  href={toSelectorHref(s.id)}
                  class="flex h-full flex-col gap-3 border border-rule p-5 text-inherit no-underline hover:border-brand hover:text-inherit"
                >
                  <SelectorAvatar id={s.id} name={s.selector.name} size={48} />
                  <div class="text-base font-bold">{s.selector.name}</div>
                  {/* 所属は任意。無い選者では詳しい理由を出す */}
                  <div class="text-[13px] leading-[1.7] text-muted">
                    {s.selector.affiliation ?? s.selector.credentials}
                  </div>
                  <div class="text-[13px] text-muted">
                    記事{s.articles.length}本
                  </div>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <SiteFooter />
    </main>
  </div>
</BaseLayout>
