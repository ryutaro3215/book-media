---
/**
 * 選者一覧（plan.md T13）。design/Senja List.dc.html 準拠。
 * 縦一列のリスト。グリッドにしない。
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import SelectorCard from "../../components/SelectorCard.astro";
import { SITE } from "../../config";
import { getSelectorGroups } from "../../lib/collections";

const groups = await getSelectorGroups();

// SEO.astro は別タスクで作成中のため、ここでは最小限の title / description を自前で持つ
const title = `選者一覧 | ${SITE.name}`;
const description = `${SITE.name}で5冊を選んでいる${groups.length}名の選者の一覧。氏名・所属・専門分野・記事数から、信頼できる選者を辿れます。`;
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main class="mx-auto max-w-body px-5 pt-[72px]">
    <h1 class="m-0 mb-10 text-[clamp(26px,3.6vw,32px)] leading-[1.5] font-bold">
      選者一覧
    </h1>

    {
      groups.length > 0 ? (
        <div>
          {groups.map((group) => (
            <SelectorCard group={group} />
          ))}
        </div>
      ) : (
        <p class="text-muted">選者はまだ登録されていません。</p>
      )
    }
  </main>

  <div class="mx-auto mt-[72px] max-w-body px-5">
    <SiteFooter />
  </div>
</BaseLayout>
