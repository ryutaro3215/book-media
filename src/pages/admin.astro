---
/**
 * 記事投稿アプリ（**ローカル専用**・plan.md T25 段階1）。
 *
 *   npm run dev  →  http://localhost:4321/admin
 *
 * ## なぜ作るか
 * CLI（npm run new:article）には運用してみて2つ問題があった。
 *   - **小トピックが919件ある。**番号付きリストに出せる量ではない
 *   - **一度進むと戻れない。**打ち間違えたら最初からやり直しになる
 * どちらも「画面がある」だけで解けるので、frontmatter の入力だけを画面にした。
 *
 * ## 長文もここで書く（段階2）
 * description / 選書理由 / いちばんよかった1冊の理由 / 本文を、この画面で書けるようにした。
 * 既存の記事を開いて直せるので、書きかけのまま閉じてよい。
 *
 * **導入文とまとめは1つの入力欄**にしてある。記事ページは frontmatter の外の
 * Markdown を**一続きで書籍カードの上に描画する**（src/pages/[slug].astro）ので、
 * 2つに分けても保存時に1つへ戻すしかなく、往復で内容が壊れる。
 *
 * ## 本番に出さない
 *   1. 開発時以外は中身を描画しない（下の `import.meta.env.DEV`）
 *   2. ビルド後に scripts/strip-admin.mjs が dist から丸ごと消す
 * 書き込み口を持つ画面なので、片方が壊れても残るようにしてある。
 */
import selectors from "../data/selectors.json";
import tags from "../data/tags.json";
import topics from "../data/topics.json";

const isDev = import.meta.env.DEV;

/** 大トピック → 小トピック。クライアント側の絞り込みに使う */
const topicMap = Object.fromEntries(
  Object.entries(topics as Record<string, { subtopics: string[] }>).map(
    ([name, meta]) => [name, meta.subtopics],
  ),
);
const tagNames = Object.keys(tags);
const selectorList = Object.entries(
  selectors as Record<string, { name: string; affiliation?: string }>,
).map(([id, s]) => ({ id, name: s.name, affiliation: s.affiliation ?? "" }));
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>記事をつくる — ローカル専用</title>
  </head>
  <body>
    {
      !isDev ? (
        <p>この画面は開発時のみ使えます。</p>
      ) : (
        <main class="wrap">
          <header class="head">
            <h1>記事をつくる</h1>
            <p class="note">
              ローカル専用の画面です。長文もここで書けます。
              書きかけの記事は上の一覧から開き直してください。
            </p>
          </header>

          <section class="card">
            <h2>編集する記事</h2>
            <label class="field">
              <span>絞り込み</span>
              <input
                id="article-filter"
                type="search"
                placeholder="タイトル・分野・タグ・選者で絞る"
                autocomplete="off"
              />
              <small id="article-count" />
            </label>
            <div class="row">
              <label class="field">
                <span>書きかけ・公開済みの記事</span>
                <select id="open-article" size="10">
                  <option value="">新しく作る</option>
                </select>
                <small>
                  下書きは<strong>最後に触った順</strong>、公開済みは公開日の順
                </small>
              </label>
              <div class="field">
                <span>&nbsp;</span>
                <button type="button" id="reload" class="ghost">
                  一覧を読み直す
                </button>
              </div>
            </div>
            <p id="editing-note" class="note" />
          </section>

          <section class="card">
            <h2>1. 誰が選ぶか</h2>
            <label class="field">
              <span>選者</span>
              <select id="selector">
                {selectorList.map((s) => (
                  <option value={s.id}>
                    {s.name}
                    {s.affiliation ? `（${s.affiliation}）` : ""}
                  </option>
                ))}
              </select>
            </label>
          </section>

          <section class="card">
            <h2>2. 分野</h2>
            <div class="row">
              <label class="field">
                <span>
                  大トピック <em>必須</em>
                </span>
                <select id="topic">
                  <option value="">選んでください</option>
                  {Object.keys(topicMap).map((name) => (
                    <option value={name}>{name}</option>
                  ))}
                </select>
                <small>この分野のページ（/topics/…）が作られます</small>
              </label>

              <label class="field">
                <span>小トピック</span>
                <select id="subtopic" disabled>
                  <option value="">先に大トピックを選ぶ</option>
                </select>
                <small>ページは作られません。検索で引っかかります</small>
              </label>
            </div>

            <div class="field">
              <span>タグ</span>
              <input
                id="tag-filter"
                type="search"
                placeholder="絞り込む（例: 統計）"
                autocomplete="off"
              />
              <div id="tag-results" class="tag-results" />
              <div id="tag-chosen" class="chips" />
              <small>小トピックより細かいもの。いくつでも</small>
            </div>
          </section>

          <section class="card">
            <h2>3. タイトル</h2>
            <div id="title-templates" class="templates" />
            <label class="field">
              <span>
                タイトル <em>必須</em>
              </span>
              <input id="title" type="text" placeholder="自由に書けます" />
            </label>
            <label class="field">
              <span>検索用タイトル</span>
              <input
                id="seoTitle"
                type="text"
                placeholder="空欄ならタイトルをそのまま使います"
              />
              <small>
                検索する人は「〇〇 入門書」と打ちます。噛み合わないときだけ
              </small>
            </label>
            <label class="field">
              <span>
                slug（URL） <em>必須</em>
              </span>
              <input
                id="slug"
                type="text"
                placeholder="rmatsuba-statistics"
                autocomplete="off"
              />
              <small id="slug-note">半角小文字の英数とハイフンのみ</small>
            </label>
            <label class="field">
              <span>説明（description）</span>
              <textarea
                id="description"
                rows="3"
                data-count="100,120"
                placeholder="空欄なら TODO: のまま出力します"
              />
              <small>
                検索結果・一覧・OGPに出ます。<b class="counter" />
              </small>
            </label>
          </section>

          <section class="card">
            <h2>4. 本</h2>
            <p class="note">
              ISBNを13桁で入れて「取得」を押すと書誌が入ります。
              取れた内容は必ず現物と照らして直してください。
            </p>
            <div id="books" />
            <button type="button" id="add-book" class="ghost">
              + 1冊ふやす
            </button>
            <p class="note">
              「知る人ぞ知る本」の印は<strong>1冊だけ</strong>付けられます。選者が「挙げた中でいちばんよかった」とした1冊に付けてください。
              付けた本は /hidden に集まります。付けなくても構いません。
            </p>
          </section>

          <section class="card">
            <h2>5. 本文</h2>
            <p class="note">
              書籍カードの<strong>上</strong>に置かれます。導入文もまとめも、
              ここに一続きで書きます（記事ページがそう描画するため、分けられません）。
              見出し（<code>## </code>）・引用（<code>&gt; </code>）が使えます。
            </p>
            <label class="field">
              <textarea id="body" rows="14" data-count="600," />
              <small>
                選者がどういう人で、この数冊で何が見えるのか。3〜5段落。
                <b class="counter" />
              </small>
            </label>
          </section>

          <div class="actions">
            <button type="button" id="save" class="primary">
              保存する
            </button>
            <p id="status" class="status" />
          </div>
        </main>
      )
    }

    <script
      is:inline
      define:vars={{ topicMap, tagNames, selectorList, enabled: isDev }}
    >
      if (enabled) {
        const $ = (id) => document.getElementById(id);
        const chosenTags = new Set();

        /**
         * 編集中の記事。空なら新規。
         * `mtimeMs` は読み込んだ時点の更新時刻で、保存時にサーバーへ返して
         * **外で変わっていないか**を見てもらう。`draft` と `publishedAt` を
         * 抱えているのは、編集で公開状態と公開日を巻き戻さないため
         * （公開済みの記事が下書きに戻る事故を一度やっている）。
         */
        let editing = null;

        // --- 文字数 ------------------------------------------------------
        // 目安であって制約ではない。範囲外でも色を変えるだけで保存は妨げない。
        // 何字が適量かは書いてみないと分からず、弾くと書く手が止まる
        function updateCount(el) {
          const [min, max] = (el.dataset.count ?? "").split(",");
          const n = el.value.trim().length;
          const counter = el.parentElement?.querySelector("small .counter");
          if (!counter) return;
          counter.textContent = max
            ? `${n}字 / ${min}〜${max}`
            : `${n}字 / ${min}字以上が目安`;
          const under = n > 0 && n < Number(min);
          const over = max && n > Number(max);
          counter.classList.toggle("off", Boolean(under || over));
        }

        function updateAllCounts() {
          for (const el of document.querySelectorAll("textarea[data-count]")) {
            updateCount(el);
          }
        }

        // 本の行は後から増える。行ごとに配線すると足し忘れるので委譲でまとめる
        document.addEventListener("input", (e) => {
          if (e.target.matches?.("textarea[data-count]")) updateCount(e.target);
        });

        // --- 分野 --------------------------------------------------------
        // 小トピックは919件ある。大トピックを選んだ時点で配下だけに絞る
        $("topic").addEventListener("change", (e) => {
          const subtopics = topicMap[e.target.value] ?? [];
          const sel = $("subtopic");
          sel.innerHTML =
            '<option value="">なし</option>' +
            subtopics.map((s) => `<option value="${s}">${s}</option>`).join("");
          sel.disabled = subtopics.length === 0;
          renderTemplates();
        });

        // --- タグ --------------------------------------------------------
        // 423件を並べても選べないので、打った語で絞ってから選ぶ
        function renderTagResults() {
          const q = $("tag-filter").value.trim();
          const box = $("tag-results");
          if (!q) {
            box.innerHTML = "";
            return;
          }
          const hits = tagNames
            .filter((t) => t.includes(q) && !chosenTags.has(t))
            .slice(0, 30);
          box.innerHTML = hits.length
            ? hits
                .map(
                  (t) =>
                    `<button type="button" class="chip add" data-tag="${t}">${t}</button>`,
                )
                .join("")
            : `<span class="note">「${q}」に当てはまるタグはありません。src/data/tags.json に足してください</span>`;
        }

        function renderChosenTags() {
          $("tag-chosen").innerHTML = [...chosenTags]
            .map(
              (t) =>
                `<button type="button" class="chip on" data-remove="${t}">${t} ×</button>`,
            )
            .join("");
        }

        $("tag-filter").addEventListener("input", renderTagResults);
        $("tag-results").addEventListener("click", (e) => {
          const tag = e.target.dataset?.tag;
          if (!tag) return;
          chosenTags.add(tag);
          renderChosenTags();
          renderTagResults();
        });
        $("tag-chosen").addEventListener("click", (e) => {
          const tag = e.target.dataset?.remove;
          if (!tag) return;
          chosenTags.delete(tag);
          renderChosenTags();
          renderTagResults();
        });

        // --- タイトル ----------------------------------------------------
        // 雛形は「押すと入る」だけ。押さずに自分で書いてもいい
        function renderTemplates() {
          const topic = $("topic").value;
          const subtopic = $("subtopic").value;
          const theme = subtopic || topic;
          const who =
            selectorList.find((s) => s.id === $("selector").value)?.name ?? "";
          const n = document.querySelectorAll(".book").length;
          if (!theme) {
            $("title-templates").innerHTML = "";
            return;
          }
          const candidates = [
            `${who}が選ぶ、${theme}の${n}冊`,
            `${theme}を本気で学ぶときに読む${n}冊`,
            `${theme}の見取り図が手に入る${n}冊`,
          ];
          $("title-templates").innerHTML =
            '<span class="note">雛形（押すと入ります）</span>' +
            candidates
              .map(
                (c) =>
                  `<button type="button" class="chip" data-title="${c}">${c}</button>`,
              )
              .join("");
        }
        $("title-templates").addEventListener("click", (e) => {
          const t = e.target.dataset?.title;
          if (t) $("title").value = t;
        });
        $("selector").addEventListener("change", renderTemplates);
        $("subtopic").addEventListener("change", renderTemplates);

        $("slug").addEventListener("input", () => {
          const v = $("slug").value.trim();
          const ok = !v || /^[a-z0-9][a-z0-9-]*$/.test(v);
          $("slug-note").textContent = ok
            ? "半角小文字の英数とハイフンのみ"
            : "使えない文字が入っています（半角小文字の英数とハイフンのみ）";
          $("slug-note").classList.toggle("bad", !ok);
        });

        // --- 本 ----------------------------------------------------------
        function bookRow(index) {
          const el = document.createElement("div");
          el.className = "book";
          el.innerHTML = `
            <div class="book-head">
              <strong>${index + 1}冊目</strong>
              <label class="best">
                <input type="radio" name="best" value="${index}" />
                知る人ぞ知る本にする
              </label>
              <button type="button" class="ghost small remove">削除</button>
            </div>
            <div class="row">
              <label class="field isbn-field">
                <span>ISBN（13桁）</span>
                <div class="isbn-row">
                  <input class="isbn" type="text" inputmode="numeric" placeholder="9784000000000" />
                  <button type="button" class="ghost fetch">取得</button>
                </div>
              </label>
              <label class="field"><span>書名</span><input class="btitle" type="text" /></label>
            </div>
            <div class="row">
              <label class="field"><span>著者</span><input class="bauthor" type="text" /></label>
              <label class="field"><span>訳者</span><input class="btranslator" type="text" placeholder="なければ空欄" /></label>
            </div>
            <div class="row">
              <label class="field"><span>出版社</span><input class="bpublisher" type="text" /></label>
              <label class="field"><span>刊行年</span><input class="byear" type="number" /></label>
            </div>
            <div class="cover-panel">
              <div class="cover-preview"><span class="cover-none">書影<br />未確認</span></div>
              <div class="cover-side">
                <p class="cover-state">ISBNの「取得」を押すと、書影が出るかどうかも分かります。</p>
                <div class="cover-upload" hidden>
                  <input type="file" class="cover-file" accept="image/*" />
                  <button type="button" class="ghost small cover-send">この画像を置く</button>
                  <p class="cover-result"></p>
                  <p class="cover-legal">
                    <b>ここに置いた画像は public/covers/ に保存され、自サイトから配信されます。</b>
                    外部APIのURLを参照するのとは違い、書影（表紙デザイン）の複製・公衆送信にあたるため、
                    <b>出版社の許諾が要ります</b>（許諾の返信は記録として残すこと）。
                    許諾が取れていない画像は置かないでください。置かなければ縦組みのフォールバックが出ます。
                    詳しくは <code>docs/covers.md</code>（運用ルールと削除要請への対応）。
                  </p>
                </div>
              </div>
            </div>
            <label class="field">
              <span>選書理由</span>
              <textarea class="breason" rows="6" data-count="300,600"></textarea>
              <small>なぜこの本を薦めるのか。<b class="counter"></b></small>
            </label>
            <label class="field best-field" hidden>
              <span>この1冊を選んだ理由</span>
              <textarea class="bbest" rows="4" data-count="150,300"></textarea>
              <small>
                この1冊を挙げた決め手。上の選書理由と重なっても構いません。
                <b class="counter"></b>
              </small>
            </label>
            <p class="warn"></p>`;
          return el;
        }

        // --- 書影 ----------------------------------------------------------
        // 書影が出るかどうかは**書き終わってビルドするまで分からなかった**。
        // 取れない本があると分かるのが遅いほど、許諾を取りに行く時間が無くなる。
        // ここで見えれば、記事を書いているその場で判断できる

        const COVER_SOURCE_LABEL = {
          local: "自前（public/covers/）",
          openbd: "openBD",
          googlebooks: "Google Books",
          fallback: "なし",
        };

        /**
         * 取得結果を1冊ぶんの表示に反映する。
         * **自前画像があるかどうかでアップロードの勧め方を変える。**
         * 外部APIから取れていても、それは差し替わりうるURLなので置く選択肢は残す
         */
        function renderCover(row, cover) {
          const preview = row.querySelector(".cover-preview");
          const state = row.querySelector(".cover-state");
          const upload = row.querySelector(".cover-upload");
          const source = cover?.source ?? "fallback";
          const url = cover?.url ?? null;

          preview.innerHTML = url
            ? `<img src="${url}" alt="" />`
            : '<span class="cover-none">書影<br />なし</span>';
          preview.classList.toggle("is-local", source === "local");

          if (source === "local") {
            state.textContent =
              "自前の画像を使っています（public/covers/）。差し替えるときだけ下から置き直してください。";
          } else if (url) {
            state.textContent = `${COVER_SOURCE_LABEL[source]} から取得。このURLは差し替わることがあるので、許諾が取れているなら自前の画像を置いてもかまいません。`;
          } else {
            state.textContent =
              "書影が取得できませんでした。このままだと縦組みのフォールバックが出ます。許諾済みの画像があれば置けます。";
          }
          upload.hidden = false;
          row.querySelector(".cover-result").textContent = "";
        }

        async function uploadCover(row) {
          const isbn = row.querySelector(".isbn").value.replace(/[^\d]/g, "");
          const result = row.querySelector(".cover-result");
          const file = row.querySelector(".cover-file").files?.[0];

          if (!/^\d{13}$/.test(isbn)) {
            result.textContent = "先に ISBN を13桁で入れてください";
            return;
          }
          if (!file) {
            result.textContent = "画像ファイルを選んでください";
            return;
          }

          // dataURL の "base64," 以降がそのまま base64 本体
          const data = await new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.onload = () => resolve(String(reader.result).split(",")[1]);
            reader.onerror = () => reject(reader.error);
            reader.readAsDataURL(file);
          });

          const post = (overwrite) =>
            fetch("/api/upload-cover.json", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({
                isbn,
                filename: file.name,
                data,
                overwrite,
              }),
            });

          result.textContent = "置いています…";
          let res = await post(false);
          let out = await res.json();

          // 既にある画像を黙って消さない（save-article.json と同じ形）
          if (res.status === 409 && out.exists) {
            const ok = confirm(
              `${out.files.join(" / ")} が既にあります。上書きしますか？\n` +
                "（同じISBNで拡張子違いのファイルは、表示が入れ替わらない事故になるため削除されます）",
            );
            if (!ok) {
              result.textContent = "中止しました";
              return;
            }
            res = await post(true);
            out = await res.json();
          }

          if (!res.ok) {
            result.textContent = `置けませんでした: ${out.error ?? res.status}`;
            return;
          }

          // 直前まで404だった画像をブラウザが握っていることがあるので、URLを変えて読ませる
          renderCover(row, {
            ...out.cover,
            url: out.cover?.url ? `${out.cover.url}?t=${Date.now()}` : null,
          });
          result.textContent =
            `${out.path} に置きました` +
            (out.replaced?.length ? `（${out.replaced.join(" / ")} は削除）` : "");
        }

        function renumber() {
          document.querySelectorAll(".book").forEach((el, i) => {
            el.querySelector(".book-head strong").textContent = `${i + 1}冊目`;
            el.querySelector('input[name="best"]').value = i;
          });
          renderTemplates();
        }

        function addBook() {
          $("books").appendChild(bookRow(document.querySelectorAll(".book").length));
          renumber();
        }

        $("add-book").addEventListener("click", addBook);

        $("books").addEventListener("click", async (e) => {
          const row = e.target.closest(".book");
          if (!row) return;

          if (e.target.classList.contains("remove")) {
            // 3冊未満は公開できないので、そこまでしか減らせない
            if (document.querySelectorAll(".book").length <= 3) {
              alert("本は3冊以上必要です。");
              return;
            }
            row.remove();
            renumber();
            return;
          }

          if (e.target.classList.contains("cover-send")) {
            e.target.disabled = true;
            try {
              await uploadCover(row);
            } catch (err) {
              row.querySelector(".cover-result").textContent =
                `置けませんでした: ${err.message}`;
            } finally {
              e.target.disabled = false;
            }
            return;
          }

          if (e.target.classList.contains("fetch")) {
            const isbn = row.querySelector(".isbn").value.replace(/[^\d]/g, "");
            const warn = row.querySelector(".warn");
            if (!/^\d{13}$/.test(isbn)) {
              warn.textContent = "ISBNは13桁の数字で入れてください";
              return;
            }
            e.target.disabled = true;
            warn.textContent = "取得中…";
            try {
              const res = await fetch("/api/isbn.json", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({ isbn }),
              });
              const data = await res.json();
              // 書誌が取れない本でも書影は取れることがある。書影の表示は found と無関係に更新する
              renderCover(row, data.cover);
              if (!data.found) {
                warn.textContent = data.warnings?.length
                  ? `要確認: ${data.warnings.join(" / ")}`
                  : "書誌が取得できませんでした。手で入れてください";
              } else {
                row.querySelector(".isbn").value = isbn;
                // 空で返ってきた項目は入れない。**既存の値をそのまま残す。**
                // サーバーは、優先すべき取得先が応答しないとき（429など）に
                // その項目を空で返す。劣る側の値で埋めると、整った値が
                // 図書館形式に差し替わる（実際に起きた）
                if (data.title) row.querySelector(".btitle").value = data.title;
                if (data.author) row.querySelector(".bauthor").value = data.author;
                if (data.translator)
                  row.querySelector(".btranslator").value = data.translator;
                if (data.publisher)
                  row.querySelector(".bpublisher").value = data.publisher;
                if (data.year) row.querySelector(".byear").value = data.year;
                warn.textContent = data.warnings.length
                  ? `要確認: ${data.warnings.join(" / ")}`
                  : "取得しました。現物と照らして確認してください";
              }
            } catch (err) {
              warn.textContent = `取得に失敗しました: ${err.message}`;
            } finally {
              e.target.disabled = false;
            }
          }
        });

        // 印は1冊だけ。印の付いていない行に理由欄を出しても書く場所が無いので隠す
        function syncBestFields() {
          for (const row of document.querySelectorAll(".book")) {
            const on = row.querySelector('input[name="best"]').checked;
            row.querySelector(".best-field").hidden = !on;
          }
        }
        $("books").addEventListener("change", (e) => {
          if (e.target.name === "best") syncBestFields();
        });

        // 3冊が下限なので、最初から3冊置いておく
        for (let i = 0; i < 3; i++) addBook();
        updateAllCounts();

        // --- 記事を開く --------------------------------------------------
        // 長文を書くには「書きかけを開き直せる」ことが要る。段階1の画面は
        // 新規ファイルを作るだけで、既存の記事を読まなかった

        /** 保存すると `TODO:` の枠が入る。開いたときは未記入として扱う */
        function unTodo(value) {
          const v = String(value ?? "");
          return v.startsWith("TODO:") ? "" : v;
        }

        /**
         * 本文から雛形コメントだけを落とす。
         * 残したまま開くと、書くたびに手で消すことになる。
         * **「要確認」コメントは残す** — あれは人が現物と照らして消すもの
         */
        function stripPlaceholders(md) {
          return String(md ?? "")
            .replace(/<!--\s*導入文をここに書く[\s\S]*?-->/g, "")
            .replace(/<!--\s*まとめもここに書く[\s\S]*?-->/g, "")
            .trim();
        }

        function resetForm() {
          editing = null;
          $("title").value = "";
          $("seoTitle").value = "";
          $("slug").value = "";
          $("description").value = "";
          $("body").value = "";
          $("topic").value = "";
          $("topic").dispatchEvent(new Event("change"));
          chosenTags.clear();
          renderChosenTags();
          renderTagResults();
          $("books").innerHTML = "";
          for (let i = 0; i < 3; i++) addBook();
          $("editing-note").textContent = "";
          $("status").className = "status";
          $("status").textContent = "";
          updateAllCounts();
        }

        /**
         * 記事一覧。**下書きと公開済みを optgroup で分ける。**
         *
         * 45本を1列に並べていたときは、開きたい記事を探すこと自体が作業だった。
         * 書きかけの続きを書くのが作業の大半で、公開済みを開くのは直しのときだけなので、
         * 頻度の違うものを同じ場所に置かない。
         *
         * 件数が増えれば区切っても結局スクロールするため、**絞り込みと併用する。**
         */
        let allArticles = [];

        function renderArticleList() {
          const q = $("article-filter").value.trim().toLowerCase();
          const hit = (a) =>
            !q ||
            [a.title, a.topic, a.subtopic, a.selector, ...(a.tags ?? [])]
              .join(" ")
              .toLowerCase()
              .includes(q);

          const shown = allArticles.filter(hit);
          const drafts = shown.filter((a) => a.draft);
          const published = shown.filter((a) => !a.draft);

          const option = (a) =>
            `<option value="${a.file}">${a.title}${a.topic ? `　— ${a.topic}` : ""}</option>`;
          const group = (label, items) =>
            items.length > 0
              ? `<optgroup label="${label}（${items.length}）">${items.map(option).join("")}</optgroup>`
              : "";

          const keep = $("open-article").value;
          $("open-article").innerHTML =
            '<option value="">新しく作る</option>' +
            group("下書き", drafts) +
            group("公開済み", published);
          // 絞り込みで消えた記事を選んだままにしない（開いている記事は別で持っている）
          $("open-article").value = keep;

          $("article-count").textContent = q
            ? `${shown.length} 件（下書き ${drafts.length} / 公開済み ${published.length}）`
            : `下書き ${drafts.length} / 公開済み ${published.length}`;
        }

        async function loadArticleList() {
          const res = await fetch("/api/articles.json", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: "{}",
          });
          const { articles } = await res.json();
          allArticles = articles;
          renderArticleList();
        }

        async function openArticle(file) {
          const res = await fetch("/api/article.json", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ slug: file }),
          });
          if (!res.ok) {
            $("status").className = "status bad";
            $("status").textContent = `開けませんでした（${file}）`;
            return;
          }
          const { data, body, mtimeMs } = await res.json();

          $("selector").value = data.selector ?? "";
          $("topic").value = data.topic ?? "";
          // 小トピックの候補は大トピックで作られる。先に change を通さないと
          // option が無く、値を入れても空に落ちる
          $("topic").dispatchEvent(new Event("change"));
          $("subtopic").value = data.subtopic ?? "";

          chosenTags.clear();
          for (const t of data.tags ?? []) chosenTags.add(t);
          renderChosenTags();
          renderTagResults();

          $("title").value = data.title ?? "";
          $("seoTitle").value = data.seoTitle ?? "";
          $("slug").value = data.slug ?? file;
          $("description").value = unTodo(data.description);
          $("body").value = stripPlaceholders(body);

          $("books").innerHTML = "";
          for (const b of data.books ?? []) {
            const row = bookRow(document.querySelectorAll(".book").length);
            $("books").appendChild(row);
            row.querySelector(".isbn").value = b.isbn ?? "";
            row.querySelector(".btitle").value = unTodo(b.title);
            row.querySelector(".bauthor").value = unTodo(b.author);
            row.querySelector(".btranslator").value = b.translator ?? "";
            row.querySelector(".bpublisher").value = unTodo(b.publisher);
            row.querySelector(".byear").value = b.year ?? "";
            row.querySelector(".breason").value = unTodo(b.reason);
            if (b.bestReason) {
              row.querySelector('input[name="best"]').checked = true;
              row.querySelector(".bbest").value = unTodo(b.bestReason);
            }
          }
          renumber();
          syncBestFields();
          updateAllCounts();

          editing = {
            file,
            mtimeMs,
            draft: data.draft !== false,
            publishedAt: String(data.publishedAt ?? ""),
          };
          const state = editing.draft ? "下書き" : "公開済み";
          const renamed =
            (data.slug ?? file) !== file
              ? `（保存先は ${data.slug}.md になります）`
              : "";
          $("editing-note").textContent = `${file}.md を編集中（${state}）${renamed}`;
          $("status").className = "status";
          $("status").textContent = "";
        }

        $("open-article").addEventListener("change", (e) => {
          if (e.target.value) openArticle(e.target.value);
          else resetForm();
        });
        $("reload").addEventListener("click", loadArticleList);
        $("article-filter").addEventListener("input", renderArticleList);
        loadArticleList();

        // --- 保存 --------------------------------------------------------
        async function save(overwrite, force) {
          const status = $("status");
          const bestIndex = Number(
            document.querySelector('input[name="best"]:checked')?.value ?? -1,
          );

          const books = [...document.querySelectorAll(".book")].map((row, i) => {
            const get = (cls) => row.querySelector(cls).value.trim();
            const warn = row.querySelector(".warn").textContent;
            const best = get(".bbest");
            return {
              isbn: get(".isbn").replace(/[^\d]/g, ""),
              title: get(".btitle"),
              author: get(".bauthor"),
              translator: get(".btranslator"),
              publisher: get(".bpublisher"),
              year: get(".byear"),
              // 空なら送らない。buildArticle が `TODO:` の枠を入れてくれる。
              // 空文字を送ると枠ごと消え、draft: false で min(1) に引っかかる
              reason: get(".breason") || undefined,
              // bestReason だけは事情が違う。**値が無いと項目ごと出力されない**
              // ので、空のまま送ると「知る人ぞ知る本」の印そのものが消える
              bestReason:
                i === bestIndex
                  ? best ||
                    "TODO: この1冊をいちばんよかったとして選んだ理由を150〜300字で書く"
                  : undefined,
              _warn: warn.startsWith("要確認") ? warn : "",
            };
          });

          const payload = {
            title: $("title").value.trim(),
            seoTitle: $("seoTitle").value.trim(),
            slug: $("slug").value.trim(),
            description: $("description").value.trim() || undefined,
            topic: $("topic").value,
            subtopic: $("subtopic").value,
            tags: [...chosenTags],
            selector: $("selector").value,
            books: books.map(({ _warn, ...b }) => b),
            body: $("body").value.trim() || undefined,
            // 取得時に食い違いが出た箇所は、ファイル冒頭のコメントに残す
            warnings: books
              .map((b, i) => (b._warn ? `${i + 1}冊目 — ${b._warn}` : null))
              .filter(Boolean),
            overwrite,
            force,
            // 編集では公開状態・公開日をそのまま返す。ここを送らないと
            // 公開済みの記事が draft: true に戻り、サイトから消える
            editing: Boolean(editing),
            mtimeMs: editing?.mtimeMs,
            draft: editing ? editing.draft : undefined,
            publishedAt: editing ? editing.publishedAt : undefined,
            // 直した日は編集のときだけ入れる。新規に更新日は要らない
            updatedAt: editing
              ? new Date().toISOString().slice(0, 10)
              : undefined,
          };

          status.className = "status";
          status.textContent = "保存中…";

          const res = await fetch("/api/save-article.json", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = await res.json();

          if (res.status === 409 && data.stale) {
            // 読み込んだあとに外で変わっている。上書きすると相手の原稿が消える
            if (
              confirm(
                "読み込んだあとにファイルが変わっています。上書きしますか？",
              )
            ) {
              await save(overwrite, true);
            } else {
              status.textContent =
                "中止しました。一覧から開き直すと最新が読めます。";
            }
            return;
          }

          if (res.status === 409) {
            if (confirm(`${data.slug}.md は既にあります。上書きしますか？`)) {
              await save(true, force);
            } else {
              status.textContent = "中止しました。";
            }
            return;
          }

          if (!res.ok) {
            status.className = "status bad";
            status.textContent = `直してください — ${(data.errors ?? [data.error]).join(" / ")}`;
            return;
          }

          // 保存すると mtime が変わる。持ち直さないと、続けて保存するたびに
          // 「外で変わっています」と言われる
          editing = {
            file: editing?.file ?? data.slug,
            mtimeMs: data.mtimeMs,
            draft: payload.draft ?? true,
            publishedAt:
              payload.publishedAt || new Date().toISOString().slice(0, 10),
          };
          $("editing-note").textContent = `${editing.file}.md を編集中（${
            editing.draft ? "下書き" : "公開済み"
          }）`;
          await loadArticleList();
          $("open-article").value = editing.file;

          status.className = "status ok";
          status.innerHTML =
            `✓ ${data.path} に保存しました。<br />` +
            "TODO: が残っていれば埋めてください。書き上がったら draft: false にします。";
        }

        $("save").addEventListener("click", () => save(false, false));
      }
    </script>

    <style is:global>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        background: #f5f4f1;
        color: #292929;
        font-family: system-ui, sans-serif;
        line-height: 1.7;
      }
      .wrap {
        max-width: 760px;
        margin: 0 auto;
        padding: 40px 20px 120px;
      }
      .head h1 {
        font-size: 1.6rem;
        margin: 0 0 8px;
      }
      .note {
        color: #767676;
        font-size: 0.85rem;
        margin: 4px 0;
      }
      .card {
        background: #fff;
        border: 1px solid #e5e3de;
        border-radius: 8px;
        padding: 20px;
        margin: 20px 0;
      }
      .card h2 {
        font-size: 1rem;
        margin: 0 0 14px;
      }
      .row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
      }
      .row > .field {
        flex: 1 1 240px;
      }
      .field {
        display: block;
        margin-bottom: 14px;
      }
      .field > span {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        margin-bottom: 4px;
      }
      .field em {
        color: #b23b2e;
        font-style: normal;
        font-size: 0.75rem;
      }
      .field small {
        display: block;
        color: #767676;
        font-size: 0.75rem;
        margin-top: 3px;
      }
      .field small.bad {
        color: #b23b2e;
      }
      input,
      select,
      textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 8px 10px;
        border: 1px solid #d7d4cd;
        border-radius: 5px;
        background: #fff;
        font: inherit;
        font-size: 0.9rem;
      }
      input:focus,
      select:focus,
      textarea:focus {
        outline: 2px solid #1f6f5c;
        outline-offset: 1px;
      }
      textarea {
        resize: vertical;
        min-height: 5em;
        line-height: 1.8;
      }
      /* 目安から外れていることだけ伝える。保存は妨げない */
      .counter {
        font-weight: 600;
      }
      .counter.off {
        color: #b23b2e;
      }
      .best-field[hidden] {
        display: none;
      }
      .isbn-row {
        display: flex;
        gap: 6px;
      }
      .isbn-row .isbn {
        flex: 1;
      }
      /* 書影は「出るか出ないか」が一目で分かればよい。原寸は要らない */
      .cover-panel {
        display: flex;
        gap: 12px;
        margin: 10px 0;
      }
      .cover-preview {
        flex: 0 0 84px;
        height: 118px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px dashed #d7d4cd;
        background: #fff;
        color: #8b867d;
        font-size: 11px;
        text-align: center;
      }
      /* 自前画像かどうかは判断が変わる情報なので、枠の見た目でも分かるようにする */
      .cover-preview.is-local {
        border: 2px solid #1f6f5c;
      }
      .cover-preview img {
        max-width: 100%;
        max-height: 100%;
      }
      .cover-side {
        flex: 1;
        min-width: 0;
        font-size: 13px;
      }
      .cover-state {
        margin: 0 0 6px;
      }
      .cover-upload[hidden] {
        display: none;
      }
      .cover-file {
        max-width: 100%;
      }
      .cover-result {
        margin: 6px 0 0;
        color: #1f6f5c;
      }
      /* 警告であって関門ではない。読める大きさで置き、操作は妨げない */
      .cover-legal {
        margin: 8px 0 0;
        padding: 8px 10px;
        border-left: 3px solid #b23b2e;
        background: #fdf5f3;
        font-size: 12px;
        line-height: 1.7;
      }
      .templates,
      .tag-results,
      .chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        align-items: center;
        margin: 6px 0;
      }
      .chip {
        border: 1px solid #d7d4cd;
        background: #fff;
        border-radius: 999px;
        padding: 4px 12px;
        font: inherit;
        font-size: 0.8rem;
        cursor: pointer;
      }
      .chip:hover {
        border-color: #1f6f5c;
      }
      .chip.on {
        background: #1f6f5c;
        border-color: #1f6f5c;
        color: #fff;
      }
      .book {
        border: 1px solid #e5e3de;
        border-radius: 6px;
        padding: 14px;
        margin-bottom: 12px;
      }
      .book-head {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 10px;
      }
      .book-head strong {
        font-size: 0.9rem;
      }
      .best {
        font-size: 0.8rem;
        color: #767676;
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 5px;
      }
      .best input {
        width: auto;
      }
      .warn {
        font-size: 0.78rem;
        color: #8a5a00;
        margin: 4px 0 0;
        min-height: 1em;
      }
      button.ghost {
        border: 1px solid #d7d4cd;
        background: #fff;
        border-radius: 5px;
        padding: 8px 14px;
        font: inherit;
        font-size: 0.85rem;
        cursor: pointer;
      }
      button.ghost.small {
        padding: 3px 10px;
        font-size: 0.78rem;
      }
      button.primary {
        background: #1f6f5c;
        color: #fff;
        border: 0;
        border-radius: 6px;
        padding: 12px 28px;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
      }
      .actions {
        position: sticky;
        bottom: 0;
        background: #f5f4f1;
        padding: 16px 0;
        border-top: 1px solid #e5e3de;
      }
      .status {
        font-size: 0.85rem;
        margin: 8px 0 0;
      }
      .status.ok {
        color: #1f6f5c;
      }
      .status.bad {
        color: #b23b2e;
      }
    </style>
  </body>
</html>
