---
/**
 * サイト共通ヘッダー。
 *
 * ## モバイル対応（plan.md T18）
 * 以前はナビも検索も `md:` 以上でしか表示されず、**スマホからは
 * ジャンル一覧・選者一覧・このサイトについてに到達できなかった**。
 * Xからの流入が主要導線＝読者の大半がモバイルなので、事業上の欠陥だった。
 *
 * 対応として、モバイルでは「ロゴ ＋ ハンバーガー」だけを出し、
 * ナビと検索は開閉パネルに入れる。検索もパネルに移すことで、
 * 狭い画面でプレースホルダが読めない問題も同時に解消している。
 *
 * JS は開閉のためだけに数行だけ使う（`aria-expanded` と Escape 対応）。
 * 外部ライブラリは使わない。
 *
 * ## 切り替えを md から lg に上げた理由
 * 「おすすめを投稿する」ボタンを足したことで、横並びの要素が
 * ロゴ・ナビ4項目・検索・ボタンの4つになった。**768px では収まらず**、
 * 検索欄が潰れるかボタンがはみ出す。タブレット幅は開閉パネル側に寄せ、
 * パネルにはナビ・検索・投稿ボタンが全部入っているので機能は落ちない。
 */
import { APPLY_CTA, NAV, SITE } from "../config";
---

<header
  class="sticky top-0 z-20 border-b border-rule bg-header backdrop-blur-[8px]"
  data-site-header
>
  <div
    class="flex h-[68px] items-center justify-between gap-4 px-5 lg:gap-8 lg:px-7"
  >
    <a
      href="/"
      class="flex-none text-[21px] font-bold tracking-[0.01em] text-ink no-underline hover:text-ink"
    >
      {SITE.name}<span class="text-brand">.</span>
    </a>

    {/* デスクトップ: ナビを横並びで出す */}
    <nav class="hidden flex-auto items-center gap-[26px] lg:flex">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="border-b-2 border-transparent py-1 text-sm font-medium text-ink no-underline hover:border-brand hover:text-brand"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {/* デスクトップ: 検索をヘッダー内に置く */}
    <form
      action="/search"
      role="search"
      class="hidden h-[38px] items-center gap-2 rounded-full border border-rule bg-canvas px-3.5 lg:flex lg:flex-[0_1_260px] xl:flex-[0_1_300px]"
    >
      <svg
        width="15"
        height="15"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        class="flex-none text-muted"
        aria-hidden="true"
      >
        <circle cx="7" cy="7" r="4.6"></circle>
        <line x1="10.4" y1="10.4" x2="14" y2="14"></line>
      </svg>
      <label for="site-search" class="sr-only">テーマ・タグ・選者・書名で検索</label>
      <input
        id="site-search"
        type="search"
        name="q"
        placeholder="テーマ・タグ・選者・書名で検索"
        class="w-full min-w-0 flex-auto border-0 bg-transparent font-sans text-sm text-ink focus:outline-none placeholder:text-muted"
      />
    </form>

    {/* デスクトップ: 投稿への導線。ナビの並びには入れず、
        ボタンとして独立させる（読む導線と書く導線を混ぜない） */}
    <a
      href={APPLY_CTA.href}
      class="hidden flex-none rounded-full bg-accent px-4 py-2 text-sm font-medium whitespace-nowrap text-canvas no-underline hover:bg-accent-hover hover:text-canvas lg:inline-block"
    >
      {APPLY_CTA.label}
    </a>

    {/* モバイル: アイコン2つをまとめて右端に寄せる。
        ヘッダーが justify-between なので、グループにしないと
        虫眼鏡がロゴとハンバーガーの中間に浮いてしまう */}
    <div class="-mr-2 flex flex-none items-center lg:hidden">
      {/* 検索は虫眼鏡だけ出し、押すとヘッダー内に入力欄を展開する。
          常時入力欄を置くと狭い画面でプレースホルダが読めないため */}
      <button
        type="button"
        data-search-toggle
        aria-expanded="false"
        aria-controls="mobile-search"
        class="flex size-11 items-center justify-center rounded-full text-ink"
      >
        <span class="sr-only" data-search-label>検索を開く</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          aria-hidden="true"
        >
          <circle cx="7" cy="7" r="4.6"></circle>
          <line x1="10.4" y1="10.4" x2="14" y2="14"></line>
        </svg>
      </button>

      {/* 開閉ボタン。タップ領域を44px以上にする */}
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="flex size-11 items-center justify-center rounded-full text-ink"
      >
        <span class="sr-only">メニューを開く</span>
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
          data-nav-icon-open
        >
          <line x1="3" y1="6" x2="17" y2="6"></line>
          <line x1="3" y1="10" x2="17" y2="10"></line>
          <line x1="3" y1="14" x2="17" y2="14"></line>
        </svg>
        <svg
          width="20"
          height="20"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          aria-hidden="true"
          class="hidden"
          data-nav-icon-close
        >
          <line x1="4.5" y1="4.5" x2="15.5" y2="15.5"></line>
          <line x1="15.5" y1="4.5" x2="4.5" y2="15.5"></line>
        </svg>
      </button>
    </div>
  </div>

  {/* モバイル: 検索バー。虫眼鏡を押すと開き、入力欄にフォーカスが当たる */}
  <div
    id="mobile-search"
    hidden
    class="border-t border-rule bg-cover-placeholder px-5 py-3 shadow-[0_2px_6px_rgba(41,41,41,0.06)] lg:hidden"
  >
    <form
      action="/search"
      role="search"
      class="flex h-11 items-center gap-2 rounded-full border border-rule bg-canvas px-4"
    >
      <svg
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        class="flex-none text-muted"
        aria-hidden="true"
      >
        <circle cx="7" cy="7" r="4.6"></circle>
        <line x1="10.4" y1="10.4" x2="14" y2="14"></line>
      </svg>
      <label for="site-search-mobile" class="sr-only">
        テーマ・タグ・選者・書名で検索
      </label>
      <input
        id="site-search-mobile"
        type="search"
        name="q"
        placeholder="テーマ・タグ・選者・書名で検索"
        data-search-input
        class="w-full min-w-0 flex-auto border-0 bg-transparent font-sans text-[15px] text-ink focus:outline-none placeholder:text-muted"
      />
    </form>
  </div>

  {/* モバイル: ナビの開閉パネル。
      白背景のページに白いパネルを重ねると境界が分からないため、
      地色を敷いて「面」として区別する */}
  <div
    id="mobile-nav"
    hidden
    class="border-t border-rule bg-cover-placeholder px-5 py-2 shadow-[0_2px_6px_rgba(41,41,41,0.06)] lg:hidden"
  >
    <nav class="flex flex-col">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            class="border-b border-rule py-3 text-[15px] font-medium text-ink no-underline last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    {/* モバイル: 投稿への導線もパネルの中に置く。
        ナビの最後にリンクとして並べると読む導線に埋もれるため、
        区切ってボタンにする */}
    <a
      href={APPLY_CTA.href}
      class="mt-3 mb-4 block rounded-full bg-accent px-4 py-3 text-center text-[15px] font-medium text-canvas no-underline hover:bg-accent-hover hover:text-canvas"
    >
      {APPLY_CTA.label}
    </a>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");

  const navToggle = header?.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navPanel = header?.querySelector<HTMLElement>("#mobile-nav");
  const iconOpen = navToggle?.querySelector<SVGElement>("[data-nav-icon-open]");
  const iconClose = navToggle?.querySelector<SVGElement>("[data-nav-icon-close]");
  const navLabel = navToggle?.querySelector<HTMLElement>(".sr-only");

  const searchToggle =
    header?.querySelector<HTMLButtonElement>("[data-search-toggle]");
  const searchPanel = header?.querySelector<HTMLElement>("#mobile-search");
  const searchInput =
    header?.querySelector<HTMLInputElement>("[data-search-input]");
  const searchLabel = searchToggle?.querySelector<HTMLElement>("[data-search-label]");

  function setNavOpen(open: boolean) {
    if (!navToggle || !navPanel) return;
    navToggle.setAttribute("aria-expanded", String(open));
    navPanel.hidden = !open;
    iconOpen?.classList.toggle("hidden", open);
    iconClose?.classList.toggle("hidden", !open);
    if (navLabel) {
      navLabel.textContent = open ? "メニューを閉じる" : "メニューを開く";
    }
  }

  function setSearchOpen(open: boolean) {
    if (!searchToggle || !searchPanel) return;
    searchToggle.setAttribute("aria-expanded", String(open));
    searchPanel.hidden = !open;
    if (searchLabel) {
      searchLabel.textContent = open ? "検索を閉じる" : "検索を開く";
    }
    // 開いたらすぐ打てるようにする
    if (open) searchInput?.focus();
  }

  navToggle?.addEventListener("click", () => {
    const open = navToggle.getAttribute("aria-expanded") !== "true";
    // 2つのパネルが同時に開くと画面が埋まるので、片方を閉じる
    if (open) setSearchOpen(false);
    setNavOpen(open);
  });

  searchToggle?.addEventListener("click", () => {
    const open = searchToggle.getAttribute("aria-expanded") !== "true";
    if (open) setNavOpen(false);
    setSearchOpen(open);
  });

  // Escape で閉じ、フォーカスを開いたボタンに戻す
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    if (searchToggle?.getAttribute("aria-expanded") === "true") {
      setSearchOpen(false);
      searchToggle.focus();
      return;
    }
    if (navToggle?.getAttribute("aria-expanded") === "true") {
      setNavOpen(false);
      navToggle.focus();
    }
  });

  // デスクトップ幅に戻ったら閉じる（パネルが開いたまま残らないように）
  window.matchMedia("(min-width: 64rem)").addEventListener("change", (e) => {
    if (!e.matches) return;
    setNavOpen(false);
    setSearchOpen(false);
  });
</script>
