---
/** 書籍カードの1枚（design/BookCardV2.dc.html）。 */
import type { Book } from "../content.config";
import { noteMissingCover, resolveCover } from "../lib/cover";
import BookCover from "./BookCover.astro";

interface Props {
  /** 1〜5。表示は 01〜05 にゼロ埋めする */
  number: number;
  book: Book;
}

const { number, book } = Astro.props;

const numberLabel = String(number).padStart(2, "0");
const authorLine = book.translator
  ? `${book.author} / ${book.translator} 訳`
  : book.author;
const publisherLine = `${book.publisher}・${book.year}`;

// ビルド時に解決する。実行時にAPIは呼ばれない
const cover = await resolveCover(book.isbn);

// 書影がない本は、ビルドログの末尾に書名つきで一覧表示する
// （どの本に画像を用意すればよいかが分かるように）
if (cover.source === "fallback") {
  noteMissingCover(book.isbn, book.title);
}
---

<article class="book-card text-ink">
  <div class="card-head">
    <div class="card-number">{numberLabel}</div>
    <div class="card-rule bg-rule"></div>
  </div>

  <div class="card-main">
    <BookCover title={book.title} coverUrl={cover.url} />
    <div class="card-meta">
      <h3 class="card-title">{book.title}</h3>
      <div class="card-author">{authorLine}</div>
      <div class="card-publisher text-muted">{publisherLine}</div>
    </div>
  </div>

  <div class="card-body">{book.reason}</div>

</article>

<style>
  /* design/BookCardV2.dc.html の固有寸法。色・罫線はトークン（クラス）側で当てる */
  .book-card {
    padding-bottom: 72px;
  }

  .card-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 24px;
  }

  .card-number {
    font-size: 28px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .card-rule {
    flex: 1 1 auto;
    height: 1px;
  }

  .card-main {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    align-items: flex-start;
    margin-bottom: 28px;
  }

  .card-meta {
    flex: 1 1 280px;
    min-width: 240px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 4px;
  }

  .card-title {
    font-size: 20px;
    font-weight: 700;
    line-height: 1.5;
    margin: 0;
    text-wrap: pretty;
  }

  .card-author {
    font-size: 15px;
    line-height: 1.7;
  }

  .card-publisher {
    font-size: 13px;
    line-height: 1.7;
  }

  .card-body {
    font-size: 17px;
    line-height: 1.9;
    text-wrap: pretty;
  }

</style>
