---
/**
 * 選者の顔写真。
 *
 * **写真は任意。** 研究者が提供を渋る場合があり、必須にすると
 * 取材のたびに交渉が発生する。未登録のときは頭文字を出すので、
 * 写真ありと無しが一覧に並んでも大きさと形が揃う。
 *
 * 画像は `public/selectors/<ファイル名>` に置く。
 */
import { getAvatarUrl } from "../lib/selectors";

interface Props {
  /** 選者ID（selectors.json のキー） */
  id: string;
  /** 表示名。未登録時の頭文字に使う */
  name: string;
  /** 一辺の px。円形に切り抜く */
  size?: number;
  class?: string;
}

const { id, name, size = 56, class: className = "" } = Astro.props;

const url = getAvatarUrl(id);
// 未登録時は氏名の1文字目を出す（姓の頭文字）
const initial = [...name.trim()][0] ?? "";
---

<div
  class:list={[
    "flex flex-none items-center justify-center overflow-hidden rounded-full bg-cover-placeholder",
    className,
  ]}
  style={`width:${size}px;height:${size}px`}
>
  {
    url ? (
      <img
        src={url}
        alt={`${name}の写真`}
        width={size}
        height={size}
        loading="lazy"
        class="h-full w-full object-cover"
      />
    ) : (
      <span
        aria-hidden="true"
        class="leading-none font-bold text-muted select-none"
        style={`font-size:${Math.round(size * 0.4)}px`}
      >
        {initial}
      </span>
    )
  }
</div>
