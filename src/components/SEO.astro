---
/**
 * <head> に入れるメタタグ一式。
 * og:image / og:url / canonical は必ず SITE.url を基準にした絶対URLで出す。
 *
 * 使い方:
 *   <SEO title="…" description="…" ogImage="/og/<slug>.png" type="article" jsonLd={…} />
 */
import { SITE } from "../config";
import { serializeJsonLd } from "../lib/jsonld";

export interface Props {
  /** ページ固有のタイトル。省略時は SITE.name のみ */
  title?: string;
  description?: string;
  /** OGP画像のパス（絶対URLでも可）。省略時は /og-default.png */
  ogImage?: string;
  type?: "website" | "article";
  /** canonical / og:url。省略時は現在のURL */
  canonical?: string;
  /** タイトルに " | サイト名" を付けない（トップページ用） */
  noSuffix?: boolean;
  noindex?: boolean;
  /** 記事用の追加メタ */
  publishedAt?: Date;
  updatedAt?: Date;
  authorName?: string;
  /** JSON-LD オブジェクト（src/lib/jsonld.ts で生成したもの） */
  jsonLd?: unknown;
}

const {
  title,
  description = SITE.description,
  ogImage = "/og-default.png",
  type = "website",
  canonical,
  noSuffix = false,
  noindex = false,
  publishedAt,
  updatedAt,
  authorName,
  jsonLd,
} = Astro.props;

/** SITE.url を基準に絶対URL化する。Astro.site が未設定でも壊れないようにする */
const base = SITE.url;
const abs = (p: string) => new URL(p, base).href;

const pageTitle = !title ? SITE.name : noSuffix ? title : `${title} | ${SITE.name}`;
const canonicalUrl = abs(canonical ?? Astro.url.pathname);
const imageUrl = abs(ogImage);
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title ?? SITE.name} />
<meta property="og:locale" content="ja_JP" />

{type === "article" && publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}
{type === "article" && (updatedAt ?? publishedAt) && (
  <meta
    property="article:modified_time"
    content={(updatedAt ?? publishedAt)!.toISOString()}
  />
)}
{type === "article" && authorName && (
  <meta property="article:author" content={authorName} />
)}

{/* X (Twitter) */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={title ?? SITE.name} />

{jsonLd && (
  <script
    type="application/ld+json"
    is:inline
    set:html={serializeJsonLd(jsonLd)}
  />
)}
