---
/**
 * 記事カードのサムネイル（plan.md T20）。
 *
 * その記事で紹介する**本の表紙を並べる**。本の記事なのに本が写っていない
 * 状態を解消するのが目的。
 *
 * ## 画像を合成しない（案A）
 * 5枚を1枚のPNGに合成して自前配信すると**複製・公衆送信**にあたる
 * （docs/covers.md の整理と同じ論点）。CSSで並べれば、書影カードと同じく
 * **外部URLを参照するだけ**なので権利上の扱いが変わらない。
 * Google Books のサムネイルは横128px程度で、合成すると粗くなるという実務的な
 * 理由もある。
 *
 * ## 書影がない本が混ざっても崩れない
 * 一部の書影が取得できないのは常態（とくに絶版本）。
 * 取得できなかった枠には書名を縦組みで置く（BookCover と同じ方針を縮小して再現）。
 *
 * ## 手動サムネイルが優先される
 * `public/thumbnails/<slug>.jpg` があればそちらを使う（既存仕様を壊さない）。
 *
 * ## 7冊以上は2段に折り返す
 * 1段のまま冊数を増やすと、枠幅は変わらないので**1冊あたりが細くなる**。
 * 10冊を236pxに並べると1冊20px弱で、背表紙のような帯にしか見えない。
 * 6冊を超えたら上下2段に割り、1冊あたりの幅を確保する。
 *
 * ## 書影の解決は BookCard と同じ入口を通す
 * ここが独自に書影を引いていたころ、トップページは記事数×冊数を一斉に問い合わせて
 * Google Books に 429 を返され、記事ページでは映る本がサムネイルでだけ消えていた。
 * 冊数ぶんを引く操作は `resolveCovers` に持たせ、**この面には並べ方だけを残す。**
 */
import type { Book } from "../content.config";
import { resolveCovers } from "../lib/cover";
import { hasManualThumbnail, resolveThumbnail } from "../lib/thumbnail";

interface Props {
  /** 記事の slug。手動サムネイルの有無を判定する */
  slug: string;
  /** 紹介する本。表紙を並べる */
  books: Book[];
  /** 枠の幅・高さ（px）。トップページのカードは 236×150 */
  width?: number;
  height?: number;
  /**
   * 枠のサイズを親に委ねる（幅・高さ 100%）。
   *
   * 記事一覧の行では、画面幅に応じてサムネイルの大きさを変えたい。
   * px 固定のままだと狭い画面で本文を圧迫するため、
   * 親側で `w-[…] sm:w-[…]` と決められるようにしてある。
   */
  fluid?: boolean;
}

const { slug, books, width = 236, height = 150, fluid = false } = Astro.props;

const manual = hasManualThumbnail(slug) ? resolveThumbnail(slug) : null;

// 手動サムネイルが無いときだけ書影を引く（ビルド時に解決済みなので追加コストは小さい）
const covers = manual ? [] : await resolveCovers(books);

/** 1段に並べる上限。これを超えたら2段に割る */
const MAX_PER_ROW = 6;

// 端数は上の段に寄せる（下の段が1冊だけ、のような割れ方を避ける）
const perRow =
  covers.length > MAX_PER_ROW ? Math.ceil(covers.length / 2) : covers.length;
const rows: (typeof covers)[] = [];
for (let i = 0; i < covers.length; i += perRow || 1) {
  rows.push(covers.slice(i, i + perRow));
}
---

<div
  class="thumb bg-cover-placeholder"
  style={fluid ? "width:100%;height:100%" : `width:${width}px;height:${height}px`}
>
  {
    manual ? (
      <img
        src={manual}
        alt=""
        width={width}
        height={height}
        loading="lazy"
        class="thumb-manual"
      />
    ) : (
      <div class="thumb-rows">
        {rows.map((row) => (
          <div class="thumb-row" style={`--per-row:${perRow}`}>
            {row.map((cover) =>
              cover.url ? (
                <img
                  class="thumb-cover"
                  data-isbn={cover.isbn}
                  src={cover.url}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="thumb-cover thumb-fallback" data-isbn={cover.isbn}>
                  <span class="thumb-fallback-title text-ink">
                    {cover.title}
                  </span>
                </div>
              ),
            )}
          </div>
        ))}
      </div>
    )
  }
</div>

<style>
  .thumb {
    overflow: hidden;
    box-sizing: border-box;
  }

  .thumb-manual {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 段は上下に等分する。1段のときは今までと同じ見え方になる */
  .thumb-rows {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    /* 枠の幅に対する比で取る。236px のとき従来の 14px / 10px と同じになり、
       記事一覧の小さい枠では余白も一緒に縮む（px 固定だと余白だけが目立つ） */
    padding: 6% 4% 4%;
    box-sizing: border-box;
  }

  /* 書影を等幅で並べる。下端を揃え、上に少し余白を残して「棚」に見せる */
  .thumb-row {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
  }

  /* 段をまたいで1冊あたりの幅をそろえる。端数の段は中央に寄る
     （`flex: 1 1 0` のままだと、冊数の少ない段だけ書影が太くなる） */
  .thumb-cover {
    flex: 0 1 calc((100% - (var(--per-row) - 1) * 4px) / var(--per-row));
    min-width: 0;
    height: 100%;
    object-fit: cover;
    display: block;
    box-shadow: 0 1px 2px rgb(41 41 41 / 0.18);
    background-color: var(--color-canvas);
  }

  /* 書影がない本。BookCover の縦組みを縮めて再現する */
  .thumb-fallback {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 5px 2px;
    box-sizing: border-box;
    border: 1px solid var(--color-cover-rule);
  }

  .thumb-fallback-title {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    font-size: 8px;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.3;
    max-height: 100%;
    overflow: hidden;
  }
</style>
