# このファイルをコピーして .env を作る（.env は git に入らない）
#   cp .env.example .env

# Cloudflare Web Analytics のトークン。
# Cloudflare ダッシュボード → Web Analytics → サイトを追加 → JS snippet の
# data-cf-beacon に入っている token の値。
# 未設定なら解析スクリプトは出力されない（サイトは問題なく動く）。
# Cookie を使わないため、同意バナーは不要。
PUBLIC_CF_BEACON_TOKEN=

# Google Books API のキー（任意）。
# 無くても書誌の照会は動く（レート制限が緩くなるだけ）。
# https://console.cloud.google.com/ → APIとサービス → 認証情報 → APIキー
# Books API を有効化してから発行する。
GOOGLE_BOOKS_API_KEY=
