{
  "name": "fivebooks",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/subset-fonts.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "astro check",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run check:links",
    "check:isbn": "node scripts/check-isbn.mjs",
    "new:article": "node scripts/new-article.mjs",
    "check:links": "node scripts/check-links.mjs",
    "new:selector": "node scripts/new-selector.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "satori": "^0.29.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "2.5.7",
    "subset-font": "^2.5.0",
    "typescript": "^6.0.3"
  }
}
